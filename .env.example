# Public marketing site ONLY.
# Do NOT put RAZORPAY_SAAS_KEY_SECRET, webhook secrets, or plan_ ids here.
# Those belong on api.topedgeai.com (chatbot-backend), never Netlify.

NEXT_PUBLIC_SITE_URL=https://www.topedgeai.com
NEXT_PUBLIC_DASH_URL=https://dash.topedgeai.com
NEXT_PUBLIC_API_URL=https://api.topedgeai.com
NEXT_PUBLIC_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

VITE_SITE_URL=https://www.topedgeai.com
VITE_DASH_URL=https://dash.topedgeai.com
VITE_API_URL=https://api.topedgeai.com
VITE_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

NEXT_PUBLIC_SITE_URL=https://www.topedgeai.com
NEXT_PUBLIC_DASH_URL=https://dash.topedgeai.com
NEXT_PUBLIC_API_URL=https://api.topedgeai.com
NEXT_PUBLIC_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

# Vite aliases (this repo is Vite, not Next)
VITE_SITE_URL=https://www.topedgeai.com
VITE_DASH_URL=https://dash.topedgeai.com
VITE_API_URL=https://api.topedgeai.com
VITE_BILLING_CATALOG_URL=https://api.topedgeai.com/api/billing/catalog

# Google Analytics 4 (optional). Leave empty to keep analytics off.
# Set to your measurement id, e.g. G-XXXXXXXXXX, in Netlify env vars to turn it on.
VITE_GA_MEASUREMENT_ID=

# Google Ads (optional). Leave empty to keep ad tagging off.
# VITE_GOOGLE_ADS_ID is the account tag (Google Ads > Admin > Google tag). It is what
# builds the remarketing audience — without it there is no retargeting list, ever.
VITE_GOOGLE_ADS_ID=
# Conversion label for the "reached signup" action (Goals > Conversions > the action
# > Tag setup > the `send_to` value after the slash). Secondary conversion only:
# the account is created on dash.topedgeai.com, not here.
VITE_GOOGLE_ADS_SIGNUP_LABEL=
